<Window x:Class="DrawingApp.UploadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="בחר ציור" Height="550" Width="450"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" 
        FlowDirection="RightToLeft">

    <Border Background="#FDF5E6" CornerRadius="30" BorderThickness="2" BorderBrush="#D2B48C">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" Direction="0" ShadowDepth="0" Color="#D2B48C" Opacity="0.5"/>
        </Border.Effect>

        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="הציורים שלי" FontSize="24" FontWeight="Bold" Foreground="#966859" HorizontalAlignment="Center"/>
                <Button Content="✕" Click="ClosePopUp_Click" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="#8B7355" FontSize="18" Cursor="Hand"/>
            </Grid>

            <Border Grid.Row="1" Background="White" CornerRadius="15" Padding="5">
                <ListBox x:Name="PaintsListBox" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#F3E5AB" BorderThickness="0,0,0,1" Padding="10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🖼️" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding}" FontSize="18" Foreground="#333" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="10" Margin="2">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFE4B5"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFF8DC"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <Button Grid.Row="2" Margin="0,20,0,0" Height="50" Content="טען ציור נבחר" 
                    Click="ConfirmSelection_Click" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#966859" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White" TextElement.FontSize="18" TextElement.FontWeight="Bold"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>